# Copy to .env (backend reads ../.env when run from backend/) and adjust as needed.
# No API keys are required: the app runs in demo mode with a deterministic mock agent.

# ---- Backend (FastAPI) ----
CMS_ENVIRONMENT=development
CMS_DATABASE_PATH=data/cms.db
# Comma-separated origins allowed to call the API directly from a browser.
CMS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# "mock" = demo mode, no key needed. Other providers are added in a later phase.
CMS_AGENT_PROVIDER=mock
# "Today" for staleness audits. Pinned to the seed's reference date so demo results never drift.
# Remove to use the real current date.
CMS_AUDIT_REFERENCE_DATE=2026-11-12
# Absolute links on this origin are treated as internal links.
CMS_SITE_BASE_URL=https://www.northstarliving.example
CMS_TOOL_TIMEOUT_SECONDS=5

# ---- Frontend (Next.js) ----
# Server-side only: where Next.js proxies /api/* requests. Put this in frontend/.env.local.
BACKEND_URL=http://127.0.0.1:8000
